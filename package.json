{
  "name": "@jyyyeung/pi-handoff",
  "version": "0.1.0",
  "description": "Reliable session handoffs for the pi coding agent: verified successor-prompt delivery, parent-tab retirement, budget-aware auto-close, and in-flight subagent-run adoption in handoff docs. Community fork of @tifan/pi-handoff.",
  "license": "MIT",
  "type": "module",
  "files": [
