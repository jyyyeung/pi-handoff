    "NOTICE.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "handoff",
    "session",
    "coding-agent",
    "multi-agent",
    "subagents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyyyeung/pi-handoff.git"
  },
  "homepage": "https://github.com/jyyyeung/pi-handoff#readme",
  "bugs": {
    "url": "https://github.com/jyyyeung/pi-handoff/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.3.0",
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0",
    "typebox": ">=0.32.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^24.0.0",
    "typebox": "*",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/session-query.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  }
